{
  "name": "personal-website",
  "type": "module",
  "version": "2.12.4",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "pagefind": "npx -y pagefind --site dist/client",
    "build:ci": "npm run build && npm run pagefind && npm run generate-pdf:ci",
    "preview": "astro preview --host",
    "generate-pdf": "node ./scripts/generate-pdf.js",
    "generate-pdf:ci": "start-server-and-test preview http://localhost:4321 generate-pdf",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/mdx": "7.0.8",
    "@astrojs/node": "11.1.4",
    "@astrojs/preact": "6.0.4",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.7",
    "astro-expressive-code": "0.44.1",
    "preact": "10.29.8",
    "rehype-autolink-headings": "7.1.0",
    "rehype-external-links": "3.0.0",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@types/react": "19.2.18",
    "playwright": "1.62.1",
    "remark-capitalize-headings": "3.0.0",
    "start-server-and-test": "3.0.12"
  }
}
